{
  "name": "sidekick",
  "version": "0.1.0",
  "private": true,
  "description": "RAG customer assistant for small businesses: hybrid retrieval, cited answers, evals, cost tracing.",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:schema": "tsx src/scripts/apply-schema.ts",
    "ingest": "tsx src/ingest.ts",
    "dev": "tsx watch src/server.ts",
    "ask": "tsx src/scripts/ask.ts",
    "eval": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
