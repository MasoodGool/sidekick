# Claude (generation + eval judge)
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5

# Embeddings (Voyage AI). Check docs.voyageai.com for current model names and dimensions.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=1024

# Postgres + pgvector (docker compose default)
DATABASE_URL=postgres://sidekick:sidekick@localhost:5433/sidekick

# Which business's documents to ingest/serve
BUSINESS_ID=sample-bakery
DATA_DIR=data/sample-bakery

# Pricing in USD per million tokens. Fill from the Anthropic pricing page;
# cost is only computed when these are set.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PRICE_CACHE_READ_PER_MTOK=
PRICE_CACHE_WRITE_PER_MTOK=

PORT=3000
