# Claude (generation + eval judge)
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5

# Embeddings (Voyage AI). voyage-3.5 defaults to 1024 dims (also 256/512/2048).
# Newer voyage-4 family exists; changing model or dim requires db:schema on a fresh DB + re-ingest.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=1024

# Postgres + pgvector (docker compose default)
DATABASE_URL=postgres://sidekick:sidekick@localhost:5433/sidekick

# Which business's documents to ingest/serve
BUSINESS_ID=sample-bakery
DATA_DIR=data/sample-bakery

# Pricing in USD per million tokens for GENERATION_MODEL; cost is only computed
# when these are set. Values: Claude Haiku 5.5, prompts <=100K tokens, 5-minute
# cache writes (platform.claude.com/docs pricing, checked 2026-10-08).
# Update these if you change GENERATION_MODEL (Sonnet 5.5: 2 / 10 / 0.10 / 2.50).
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
PRICE_CACHE_READ_PER_MTOK=0.01
PRICE_CACHE_WRITE_PER_MTOK=0.125

PORT=3000
